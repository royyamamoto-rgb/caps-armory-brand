{
  "name": "@capsarmory/brand",
  "version": "0.0.1-alpha.0",
  "description": "CAPS Armory brand surface: tokens, marks, typography, asset manifest",
  "license": "MIT",
  "author": "Caps Armory LLC <roy.yamamoto@gmail.com>",
  "homepage": "https://github.com/royyamamoto-rgb/caps-armory-brand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royyamamoto-rgb/caps-armory-brand.git"
  },
  "bugs": {
    "url": "https://github.com/royyamamoto-rgb/caps-armory-brand/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tarball": "tsx scripts/tarball-check.ts",
    "drift-check": "tsx scripts/drift-detect.ts",
    "extract-tokens": "tsx scripts/extract-tokens.ts",
    "extract-fonts": "tsx scripts/extract-fonts.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish --tag alpha"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./tokens/dark": {
      "types": "./dist/tokens/dark.d.ts",
      "import": "./dist/tokens/dark.js",
      "require": "./dist/tokens/dark.cjs"
    },
    "./tokens/light": {
      "types": "./dist/tokens/light.d.ts",
      "import": "./dist/tokens/light.js",
      "require": "./dist/tokens/light.cjs"
    },
    "./tokens/dark.css": "./dist/tokens/dark.css",
    "./tokens/light.css": "./dist/tokens/light.css",
    "./tokens/json": "./dist/tokens/tokens.json",
    "./fonts/inter.css": "./dist/fonts/inter.css",
    "./marks/Crest": {
      "types": "./dist/marks/Crest.d.ts",
      "import": "./dist/marks/Crest.js",
      "require": "./dist/marks/Crest.cjs"
    },
    "./marks/Wordmark": {
      "types": "./dist/marks/Wordmark.d.ts",
      "import": "./dist/marks/Wordmark.js",
      "require": "./dist/marks/Wordmark.cjs"
    },
    "./marks/Iconmark": {
      "types": "./dist/marks/Iconmark.d.ts",
      "import": "./dist/marks/Iconmark.js",
      "require": "./dist/marks/Iconmark.cjs"
    },
    "./marks/Crest.svg": "./dist/marks/Crest.svg",
    "./marks/Wordmark.svg": "./dist/marks/Wordmark.svg",
    "./marks/Iconmark.svg": "./dist/marks/Iconmark.svg",
    "./manifest": "./dist/manifest/asset-manifest.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "2.27.9",
    "@fontsource-variable/inter": "5.1.0",
    "@types/node": "22.9.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-istanbul": "3.0.0",
    "@vitest/coverage-v8": "3.0.0",
    "happy-dom": "15.11.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "svgo": "3.3.2",
    "ts-morph": "24.0.0",
    "tsup": "8.3.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "3.0.0",
    "wcag-contrast": "3.0.0"
  }
}
